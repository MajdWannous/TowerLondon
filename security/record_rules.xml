<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- 🟢 Receptionist Rules -->
    <record id="rule_receptionist_patient_access" model="ir.rule">
      <field name="name">Receptionist: All Patients</field>
      <field name="model_id" ref="model_tower_patient"/>
      <field name="groups" eval="[(4, ref('tower_london.group_tower_receptionist'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    <record id="rule_receptionist_test_access" model="ir.rule">
      <field name="name">Receptionist: All Tests</field>
      <field name="model_id" ref="model_tower_of_london"/>
      <field name="groups" eval="[(4, ref('tower_london.group_tower_receptionist'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

    <!-- 🟠 Specialist Rules -->
    <record id="rule_specialist_test_access" model="ir.rule">
      <field name="name">Specialist: Own Tests Only</field>
      <field name="model_id" ref="model_tower_of_london"/>
      <field name="groups" eval="[(4, ref('tower_london.group_tower_specialist'))]"/>
      <field name="domain_force">[('create_uid', '=', user.id)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <!-- 🔵 Finance Rules -->
    <record id="rule_finance_tower_invoices" model="ir.rule">
      <field name="name">Finance: Tower Invoices Only</field>
      <field name="model_id" ref="account.model_account_move"/>
      <field name="groups" eval="[(4, ref('tower_london.group_tower_finance'))]"/>
      <field name="domain_force">[('tower_patient_id', '!=', False)]</field>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

  </data>
</odoo>
